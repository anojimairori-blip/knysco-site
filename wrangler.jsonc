{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knysco-site",
  "main": "src/index.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "MAIL_FROM": "info@send.kny-s.co.jp",
    "MAIL_TO": "info@kny-s.co.jp",
    "MAIL_FROM_NAME": "金山商事株式会社 お問い合わせフォーム",
    "TEL_DISPLAY": "048-281-7191",
    "FAX_DISPLAY": "048-286-2891",
    "AUTO_REPLY": "1"
  }
}
